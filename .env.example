# Hotel Paraíso — variables de entorno (EJEMPLO)
#
# 1. Copia este archivo:      cp .env.example .env
# 2. Escribe tus valores reales en .env (ese archivo NO se sube a Git).
# 3. Nunca pongas credenciales reales en este archivo de ejemplo.
#
# Formato: CLAVE=valor  (sin espacios alrededor del "="; comillas opcionales)

# Servidor MySQL
DB_HOST=127.0.0.1
DB_PORT=3306

# Base de datos y usuario de la aplicación
DB_NAME=HotelDB
DB_USER=hotel_app

# Contraseña del usuario de la aplicación.
# Debe existir la variable; puede quedar vacía solo en entornos locales sin contraseña.
DB_PASS=cambia_esta_clave
